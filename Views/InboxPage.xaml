<Page
    x:Class="Ntfy.Windows.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ntfy.Windows.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/><Setter Property="CornerRadius" Value="8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ModeToggleButton" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="112"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="16" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="44,*,86" ColumnSpacing="8">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8BD;" FontSize="19" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TopicsTitleText" Text="Topics" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="CurrentInstanceText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ToggleButton x:Name="AllTopicsButton" Grid.Column="2" Click="AllTopics_Click" Width="86" Height="40" Padding="6,0" CornerRadius="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8BD;" FontSize="12"/>
                            <TextBlock x:Name="AllTopicsButtonText" FontSize="13"/>
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="NewTopicBox" PlaceholderText="topic name" Style="{StaticResource RoundedTextBox}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="AddTopicButton" Click="AddTopic_Click" Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        </Button>
                        <Button x:Name="SyncSubscriptionsButton" Click="SyncSubscriptions_Click" Style="{StaticResource IconButton}">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="2" x:Name="TopicList" ItemsSource="{x:Bind TopicItems}" SelectionChanged="TopicList_SelectionChanged" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/><Setter Property="MinHeight" Value="44"/><Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TopicListItem">
                            <Grid Height="44" PointerEntered="TopicRow_PointerEntered" PointerExited="TopicRow_PointerExited" ContextRequested="TopicRow_ContextRequested">

                                <Border x:Name="HoverFrame" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0"/>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="10,0">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE74F;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind MutedVisibility}" ToolTipService.ToolTip="{x:Bind MutedIndicatorTooltip}" AutomationProperties.Name="{x:Bind MutedIndicatorTooltip}"/>
                                    <Border Grid.Column="3" MinWidth="20" Height="20" Padding="5,0" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind BadgeVisibility}">
                                        <TextBlock Text="{x:Bind UnreadText}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="3" Padding="10,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowSpacing="12" Padding="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="InboxTitleText" Text="Inbox" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock x:Name="MessageHintText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Style="{StaticResource RoundedTextBox}" MinWidth="180">
                    <TextBox.Resources><FontIcon x:Key="SearchIcon" Glyph="&#xE721;"/></TextBox.Resources>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PriorityFilter" Width="160" SelectionChanged="Filter_Changed" MinHeight="40" CornerRadius="8"/>
                    <StackPanel x:Name="SelectionActionsPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                        <Button x:Name="CopySelectedButton" Click="CopySelected_Click" Style="{StaticResource IconButton}"><FontIcon Glyph="&#xE8C8;" FontSize="14"/></Button>
                        <Button x:Name="DeleteSelectedButton" Click="DeleteSelected_Click" Style="{StaticResource IconButton}"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
                    </StackPanel>
                    <ToggleButton x:Name="UnreadOnlyToggle" Click="Filter_Changed" Width="40" Height="40" Padding="0" CornerRadius="8"><FontIcon Glyph="&#xE715;" FontSize="15"/></ToggleButton>
                    <Button x:Name="MarkAllReadButton" Click="MarkAllRead_Click" Style="{StaticResource IconButton}"><FontIcon Glyph="&#xE73E;" FontSize="15"/></Button>
                    <ToggleButton x:Name="MultiSelectToggle" Click="MultiSelectToggle_Click" Width="40" Height="40" Padding="0" CornerRadius="8"><FontIcon Glyph="&#xE762;" FontSize="15"/></ToggleButton>
                    <Button x:Name="ClearHistoryButton" Click="ClearHistory_Click" Style="{StaticResource IconButton}"><FontIcon Glyph="&#xE894;" FontSize="15"/></Button>
                </StackPanel>
            </Grid>
            <ListView Grid.Row="2" x:Name="MessagesList" ItemsSource="{x:Bind Messages}" SelectionMode="None" SelectionChanged="MessagesList_SelectionChanged" IsMultiSelectCheckBoxEnabled="False" IsItemClickEnabled="True" ItemClick="MessagesList_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                </ListView.Resources>
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="8"/><Setter Property="MinHeight" Value="88"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NtfyMessage">
                        <Border Padding="12" MinHeight="88" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" PointerEntered="MessageCard_PointerEntered" PointerExited="MessageCard_PointerExited">
                            <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{x:Bind UnreadIndicator, Mode=OneWay}" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                                    <Border Width="40" Height="40" Margin="0,0,16,0" CornerRadius="4" Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="UniformToFill" ImageOpened="MessageIcon_ImageOpened" ImageFailed="MessageIcon_ImageFailed"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="{x:Bind Topic}" Visibility="{x:Bind TopicVisibility, Mode=OneWay}" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="WrapWholeWords" MaxLines="3"/>
                                        <TextBlock Text="{x:Bind MetadataSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" MaxLines="2"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayTimestamp}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="3" Padding="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnDefinitions="40,*,96" ColumnSpacing="10">
                    <Button x:Name="OpenPublishDialogButton" Click="OpenPublishDialog_Click" Style="{StaticResource IconButton}"><FontIcon Glyph="&#xE946;" FontSize="16"/></Button>
                    <TextBox x:Name="ComposeBox" Grid.Column="1" Style="{StaticResource RoundedTextBox}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110"/>
                    <Button x:Name="SendButton" Grid.Column="2" Click="Send_Click" Style="{StaticResource ToolbarButton}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE724;" FontSize="14"/><TextBlock x:Name="SendText"/></StackPanel></Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
